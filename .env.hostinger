# ── Kingslee AIOS — Hostinger shared hosting (Node.js app, LITE mode) ──
# Fill the 3 REPLACE_ values. Do NOT commit real secrets — set them in the
# Hostinger Node.js app "Environment variables" panel instead of a file.

NODE_ENV=production
LITE_MODE=true
# PORT is set by Hostinger/Passenger — leave unset.

# Frontend is served by this same process (same origin) — leave NEXT_PUBLIC_API_URL unset.
APP_URL=https://ai.kingslee.net

# ── Supabase Postgres (your project). Replace [YOUR-DB-PASSWORD] with your
#    database password from Supabase → Project Settings → Database.
#    Enable the "vector" extension in Supabase before first run. ──
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.twbklhipuzppkrbvheca.supabase.co:5432/postgres
# (No REDIS_URL in lite mode.)

# ── Secrets — generate each with: openssl rand -hex 32 ──
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARS

# ── AI (required) ──
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=                    # optional — enables image generation + embeddings

DEFAULT_FROM_EMAIL=hello@kingslee.net
