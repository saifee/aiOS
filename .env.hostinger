# ── Kingslee AIOS — LITE mode for Hostinger Node.js app (single process) ──
NODE_ENV=production
LITE_MODE=true                     # disables Redis/background workers; boots without them
PORT=                              # leave blank — Hostinger/Passenger sets this

# Frontend is served by this same process, same origin — leave NEXT_PUBLIC_API_URL unset.
APP_URL=https://ai.kingslee.net

# ── Database: your Supabase connection string (Project Settings → Database) ──
# Use the "Connection pooling" / Transaction URL if provided; enable the "vector"
# extension in Supabase (Database → Extensions) before first run.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# No REDIS_URL in lite mode (leave unset).

# ── Secrets (generate: openssl rand -hex 32) ──
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARS

# ── AI (required) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=                    # optional — enables image generation + embeddings

DEFAULT_FROM_EMAIL=hello@kingslee.net
