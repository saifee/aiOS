# ── Kingslee AIOS — Hostinger Cloud (Node.js web app) ──────────────────────────
# Paste these into hPanel → Websites → your site → Node.js → Environment variables.
# Never commit real secrets. Generate secrets with:  openssl rand -hex 32

NODE_ENV=production
LITE_MODE=true                 # no Redis: background workers run inside the app
AUTO_MIGRATE=true              # creates/updates tables on start (safe: never drops data)
APP_URL=https://ai.kingslee.net

# Supabase → Connect → "Session pooler" (NOT the direct db.xxx host: it is IPv6-only and
# Hostinger cannot reach it). Paste the pooler string, add the two parameters at the end.
DATABASE_URL=postgresql://postgres.twbklhipuzppkrbvheca:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connection_limit=5&sslmode=require

JWT_SECRET=REPLACE_openssl_rand_hex_32
ENCRYPTION_KEY=REPLACE_64_hex_chars
CRON_SECRET=REPLACE_openssl_rand_hex_16      # protects /v1/cron/tick

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=                # optional: knowledge-brain embeddings + images
DEFAULT_FROM_EMAIL=hello@kingslee.net
# SENDGRID_API_KEY=  GOOGLE_PLACES_API_KEY=  WHATSAPP_CLOUD_TOKEN= ...  (add as you enable features)
