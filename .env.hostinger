# ── Kingslee AIOS — Hostinger Cloud (Node.js web app + Hostinger MySQL) ─────────
# Paste into hPanel → Websites → ai.saifullahkhalid.com → Node.js → Environment variables.
# Generate secrets with:  openssl rand -hex 32     (or any password generator, hex only for ENCRYPTION_KEY)

NODE_ENV=production
LITE_MODE=true                  # no Redis: background workers run inside the app
AUTO_MIGRATE=true               # creates the tables on first start (safe to leave on)
APP_URL=https://ai.saifullahkhalid.com

# hPanel → Databases → Management: create a database + user, then:
#   mysql://DBUSER:DBPASSWORD@localhost:3306/DBNAME
# (Hostinger names look like u123456789_aios. If the password has symbols like @ # / %, URL-encode them.)
DATABASE_URL=mysql://u123456789_aios:PASSWORD@localhost:3306/u123456789_aios?connection_limit=5

JWT_SECRET=REPLACE_openssl_rand_hex_32
ENCRYPTION_KEY=REPLACE_exactly_64_hex_chars
CRON_SECRET=REPLACE_openssl_rand_hex_16       # protects /v1/cron/tick

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=                 # optional: Knowledge Brain embeddings + images
DEFAULT_FROM_EMAIL=hello@saifullahkhalid.com
# SENDGRID_API_KEY=  GOOGLE_PLACES_API_KEY=  WHATSAPP_CLOUD_TOKEN= ...  (add as you enable features)
