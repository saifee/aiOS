{
  "name": "@leadhunter/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../../scripts/bundle.mjs src/server.ts dist/server.js",
    "start": "node dist/server.js",
    "lint": "echo ok",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:standalone": "node ../../scripts/bundle.mjs --standalone src/server.ts dist-standalone/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@leadhunter/agents": "*",
    "@leadhunter/db": "*",
    "bullmq": "^5.8.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-raw-body": "^6.0.2",
    "ioredis": "^5.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.4"
  }
}
