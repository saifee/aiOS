// aiOS — multi-tenant schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ────────────── Tenancy & Users ──────────────

model Tenant {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  plan             Plan         @default(FREE)
  stripeCustomerId String?
  createdAt        DateTime     @default(now())
  users            Membership[]
  businesses       Business[]
  auditLogs        AuditLog[]
  aiKeys           AiKey[]
  payments         Payment[]
}

enum Plan {
  TRIAL
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
  FREE   // appended last so existing MySQL ENUM columns can be extended in place
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  notifications Notification[]
  aiKeys        AiKey[]
  identities    OAuthIdentity[]
  prefs         UserPref[]
}

model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     Role   @default(MEMBER)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ────────────── Business workspace ──────────────

model Business {
  id                  String        @id @default(cuid())
  tenantId            String
  name                String
  description         String? @db.Text
  services            Json? @default("[]")
  industriesServed    Json? @default("[]")
  targetCountries     Json? @default("[]")
  targetCities        Json? @default("[]")
  keywords            Json? @default("[]")
  negativeKeywords    Json? @default("[]")
  idealCompanySizeMin Int?
  idealCompanySizeMax Int?
  decisionMakerTitles Json? @default("[]")
  maxOutreachPerDay   Int           @default(50)
  workingHoursStart   String        @default("09:00")
  workingHoursEnd     String        @default("18:00")
  timezone            String        @default("Asia/Riyadh")
  languages           Json? @default("[\"en\"]")
  tone                String        @default("professional")
  calendarLink        String? @db.Text
  minLeadScore        Int           @default(60)
  branding            Json?
  notificationPrefs   Json?
  createdAt           DateTime      @default(now())
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns           Campaign[]
  leads               Lead[]
  templates           Template[]
  integrations        Integration[]
  insights            Insight[]
  agents              Agent[]
  goals               Goal[]
  decisions           Decision[]
  bookings            Booking[]
  @@index([tenantId])
}

model Integration {
  id          String   @id @default(cuid())
  businessId  String
  provider    String
  status      String   @default("disconnected")
  credentials Json?
  config      Json?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, provider])
}

model Template {
  id         String   @id @default(cuid())
  businessId String
  channel    Channel
  name       String
  subject    String?
  body       String @db.Text
  language   String   @default("en")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ────────────── Campaigns ──────────────

model Campaign {
  id           String         @id @default(cuid())
  businessId   String
  name         String
  status       CampaignStatus @default(ACTIVE)
  channels     Json? @default("[]")
  sources      Json? @default("[]")
  followUpDays Json? @default("[3,7,14]")
  maxFollowUps Int            @default(3)
  createdAt    DateTime       @default(now())
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads        Lead[]
  @@index([businessId])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}
enum Channel {
  EMAIL
  WHATSAPP
  LINKEDIN
  SMS
  CALL
}

// ────────────── Leads / CRM ──────────────

model Lead {
  id              String         @id @default(cuid())
  businessId      String
  campaignId      String?
  companyName     String
  website         String? @db.Text
  industry        String?
  country         String?
  city            String?
  address         String? @db.Text
  phones          Json? @default("[]")
  emails          Json? @default("[]")
  whatsapp        String?
  linkedin        String? @db.Text
  facebook        String? @db.Text
  instagram       String? @db.Text
  employeeCount   Int?
  companySize     String?
  techStack       Json? @default("[]")
  growthSignals   Json?
  painPoints      Json? @default("[]")
  latestNews      Json?
  potentialNeed   String? @db.Text
  estimatedBudget String?
  confidenceScore Int            @default(0)
  leadScore       Int            @default(0)
  scoreBreakdown  Json?
  stage           Stage          @default(FOUND)
  sourceUrl       String? @db.Text
  source          String?
  dedupeKey       String?
  optedOut        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign        Campaign?      @relation(fields: [campaignId], references: [id])
  contacts        Contact[]
  activities      Activity[]
  messages        Message[]
  conversations   Conversation[]
  meetings        Meeting[]
  calls           Call[]
  @@unique([businessId, dedupeKey])
  @@index([businessId, stage])
  @@index([businessId, leadScore])
}

enum Stage {
  FOUND
  QUALIFIED
  CONTACTED
  REPLIED
  INTERESTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

model Contact {
  id        String  @id @default(cuid())
  leadId    String
  name      String?
  title     String?
  email     String?
  phone     String?
  whatsapp  String?
  linkedin  String? @db.Text
  isPrimary Boolean @default(false)
  sourceUrl String? @db.Text
  verified  Boolean @default(false)
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId])
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  detail    Json?
  actor     String   @default("ai")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
}

// ────────────── Messaging ──────────────

model Message {
  id          String    @id @default(cuid())
  leadId      String
  channel     Channel
  direction   Direction
  subject     String?
  body        String @db.Text
  status      MsgStatus @default(QUEUED)
  providerId  String?
  openedAt    DateTime?
  repliedAt   DateTime?
  scheduledAt DateTime?
  sentAt      DateTime?
  meta        Json?
  createdAt   DateTime  @default(now())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
  @@index([status, scheduledAt])
}

enum Direction {
  OUTBOUND
  INBOUND
}
enum MsgStatus {
  QUEUED
  SCHEDULED
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
  SUPPRESSED
}

model Conversation {
  id            String    @id @default(cuid())
  leadId        String
  channel       Channel
  state         ConvState @default(AI_HANDLING)
  intent        String?
  summary       String? @db.Text
  handoffReason String? @db.Text
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

enum ConvState {
  AI_HANDLING
  HUMAN_HANDOFF
  CLOSED
}

model Meeting {
  id       String   @id @default(cuid())
  leadId   String
  provider String
  startsAt DateTime
  endsAt   DateTime
  joinUrl  String? @db.Text
  status   String   @default("scheduled")
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ────────────── Notifications, Learning, Compliance ──────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String @db.Text
  kind      String
  channels  Json? @default("[]")
  readAt    DateTime?
  meta      Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Insight {
  id         String   @id @default(cuid())
  businessId String
  kind       String
  data       Json
  computedAt DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Suppression {
  id        String   @id @default(cuid())
  scope     String
  value     String
  reason    String
  createdAt DateTime @default(now())
  @@unique([scope, value])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actor     String
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
//  AI OPERATING SYSTEM — agents, memory/knowledge, orchestration
// ═══════════════════════════════════════════════════════════════

// A registered AI employee (one per department, per business).
model Agent {
  id           String     @id @default(cuid())
  businessId   String
  role         String     // ceo_assistant | receptionist | sales | marketing | ... (see registry)
  displayName  String
  status       String     @default("active")   // active | paused
  config       Json?      // model, temperature, autonomy level, per-agent overrides
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs         AgentRun[]
  memories     Memory[]
  @@unique([businessId, role])
  @@index([businessId])
}

// One execution of an agent (a "shift"): input, tool calls, output, cost.
model AgentRun {
  id         String    @id @default(cuid())
  agentId    String
  trigger    String    // event | command | schedule | agent_message | manual
  input      Json
  output     Json?
  toolCalls  Json?     // [{ name, input, result }]
  status     String    @default("running") // running | done | failed | awaiting_approval
  tokensIn   Int       @default(0)
  tokensOut  Int       @default(0)
  error      String? @db.Text
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([agentId, startedAt])
}

// Inter-agent messages (the "Slack" between AI employees).
model AgentMessage {
  id          String   @id @default(cuid())
  businessId  String
  fromRole    String
  toRole      String
  subject     String?
  body        String @db.Text
  payload     Json?
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([businessId, toRole, handled])
}

// Domain event log — the event-driven backbone.
model Event {
  id         String   @id @default(cuid())
  businessId String
  type       String   // lead.qualified | call.completed | proposal.requested | invoice.overdue ...
  payload    Json
  createdAt  DateTime @default(now())
  @@index([businessId, type, createdAt])
}

// Agent memory + Knowledge Brain chunks. `embedding` is a JSON array of floats (cosine similarity is computed in the app)
// (added via migration SQL). Similarity search runs through raw SQL.
model Memory {
  id         String                 @id @default(cuid())
  businessId String
  agentId    String?
  kind       String                 // fact | preference | episodic | summary
  content    String @db.Text
  embedding  Json?
  createdAt  DateTime               @default(now())
  agent      Agent?                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([businessId, kind])
}

model KnowledgeChunk {
  id         String                 @id @default(cuid())
  businessId String
  source     String                 // lead | message | call | doc | invoice | project | contract | email
  sourceId   String?
  title      String?
  content    String @db.Text
  metadata   Json?
  embedding  Json?
  createdAt  DateTime               @default(now())
  @@index([businessId, source])
}

// Human-in-the-loop approvals for sensitive AI actions.
model Approval {
  id          String    @id @default(cuid())
  businessId  String
  agentRole   String
  action      String    // send_contract | issue_refund | send_proposal | deploy | large_spend ...
  summary     String @db.Text
  payload     Json
  status      String    @default("pending") // pending | approved | rejected
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  @@index([businessId, status])
}

// ─────────── Operations domain (used by department agents) ───────────

model Project {
  id          String    @id @default(cuid())
  businessId  String
  leadId      String?
  name        String
  status      String    @default("active") // planning | active | at_risk | delivered | closed
  health      String    @default("green")  // green | yellow | red
  startDate   DateTime?
  dueDate     DateTime?
  budget      Float?
  createdAt   DateTime  @default(now())
  tasks       Task[]
  @@index([businessId, status])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String?
  businessId  String
  title       String
  assignee    String?   // human email or agent role
  status      String    @default("todo") // todo | doing | blocked | done
  priority    String    @default("medium")
  estimateHrs Float?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([businessId, status])
}

model Proposal {
  id          String   @id @default(cuid())
  businessId  String
  leadId      String?
  title       String
  packageName String?
  amount      Float?
  currency    String   @default("SAR")
  status      String   @default("draft") // draft | sent | accepted | rejected
  contentHtml String? @db.Text
  createdAt   DateTime @default(now())
  @@index([businessId, status])
}

model Invoice {
  id          String    @id @default(cuid())
  businessId  String
  leadId      String?
  number      String
  amount      Float
  currency    String    @default("SAR")
  status      String    @default("draft") // draft | sent | paid | overdue
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  @@index([businessId, status])
}

// AI Receptionist call records.
model Call {
  id          String    @id @default(cuid())
  businessId  String
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  direction   String    @default("inbound")
  fromNumber  String
  toNumber    String
  provider    String    @default("twilio")
  callSid     String?   @unique
  status      String    @default("in_progress") // in_progress | completed | missed | transferred
  language    String?
  recordingUrl String? @db.Text
  transcript  Json?     // [{ role, text, ts }]
  summary     String? @db.Text
  sentiment   String?
  intent      String?
  durationSec Int?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  @@index([businessId, startedAt])
}

// ═══════════════════════════════════════════════════════════════
//  BILLING (Stripe) + SOP ENGINE
// ═══════════════════════════════════════════════════════════════

model Subscription {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  plan                 Plan      @default(TRIAL)
  status               String    @default("trialing") // trialing | active | past_due | canceled
  stripeSubscriptionId String?
  stripePriceId        String?
  seats                Int       @default(1)
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Usage counters for plan-limit enforcement (per tenant, per billing month).
model UsageCounter {
  id         String   @id @default(cuid())
  tenantId   String
  period     String   // "2026-07"
  metric     String   // leads | outreach | calls | agent_runs
  count      Int      @default(0)
  @@unique([tenantId, period, metric])
}

// A Standard Operating Procedure the AI captured or was taught.
model Sop {
  id          String    @id @default(cuid())
  businessId  String
  title       String
  department  String?
  description String? @db.Text
  trigger     String?   // manual | event:<type> | schedule:<cron>
  steps       Json      // [{ n, action, tool?, owner? }]
  status      String    @default("draft") // draft | active | archived
  automation  Json?     // { role, input } — how to run it autonomously
  source      String    @default("manual") // manual | observed | taught
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  runs        SopRun[]
  @@index([businessId, status])
}

model SopRun {
  id        String    @id @default(cuid())
  sopId     String
  status    String    @default("running") // running | done | failed
  result    Json?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  sop       Sop       @relation(fields: [sopId], references: [id], onDelete: Cascade)
}

// Expenses — makes BI profit, cash flow, and runway real (not estimated).
model Expense {
  id         String   @id @default(cuid())
  businessId String
  category   String   // salaries | infrastructure | software | marketing | contractors | office | other
  vendor     String?
  amount     Float
  currency   String   @default("SAR")
  recurring  Boolean  @default(false)
  incurredAt DateTime @default(now())
  note       String? @db.Text
  createdAt  DateTime @default(now())
  @@index([businessId, incurredAt])
}

// ═══════════════════════════════════════════════════════════════
//  TIER 3 — Dev Swarm, Creative hands, Social publishing
// ═══════════════════════════════════════════════════════════════

// One run of the multi-model developer swarm.
model SwarmRun {
  id          String    @id @default(cuid())
  businessId  String
  task        String @db.Text
  repo        String?   // owner/name for GitHub PR
  status      String    @default("running") // running | review | testing | awaiting_approval | done | failed
  stages      Json?     // [{ role, model, output, at }]
  changeset   Json?     // [{ path, content }]
  testOutput  String? @db.Text
  testsPassed Boolean?
  prUrl       String? @db.Text
  branch      String?
  createdAt   DateTime  @default(now())
  endedAt     DateTime?
  @@index([businessId, createdAt])
}

// Generated creative assets (images, video jobs).
model MediaAsset {
  id          String   @id @default(cuid())
  businessId  String
  kind        String   // image | video
  prompt      String @db.Text
  provider    String   // openai | heygen | ...
  status      String   @default("ready") // pending | ready | failed
  url         String? @db.Text
  providerRef String?  // provider job id
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([businessId, kind])
}

// Marketing content queued/published across social channels.
model SocialPost {
  id          String    @id @default(cuid())
  businessId  String
  channel     String    // linkedin | facebook | instagram | x | tiktok | youtube
  content     String @db.Text
  mediaUrl    String? @db.Text
  status      String    @default("draft") // draft | scheduled | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?
  providerRef String?
  error       String? @db.Text
  createdAt   DateTime  @default(now())
  @@index([businessId, status])
}


// ── aiOS: bring-your-own AI keys (per user, encrypted at rest) ──────────────
model AiKey {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  provider  String            // anthropic | openai | gemini | groq | openrouter | ... | custom
  label     String?
  model     String?           // blank = provider default
  baseUrl   String?           // custom OpenAI-compatible endpoints only
  keyEnc    String    @db.Text
  keyHint   String            // last 4 characters, for display
  priority  Int       @default(0)   // failover order, lowest first
  enabled   Boolean   @default(true)
  shared    Boolean   @default(true) // let teammates + background jobs of this workspace use it
  lastOkAt  DateTime?
  lastError String?   @db.Text
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([tenantId, priority])
  @@index([userId])
}

// Per-user UI preferences (dashboard layouts etc.)
model UserPref {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
}

// Chief-of-staff memory: goals/lanes and a decision log
model Goal {
  id         String    @id @default(cuid())
  businessId String
  title      String
  lane       String?
  target     String?
  progress   Int       @default(0)
  status     String    @default("active") // active | done | paused
  dueAt      DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, status])
}

model Decision {
  id         String   @id @default(cuid())
  businessId String
  title      String
  context    String?  @db.Text
  outcome    String?  @db.Text
  decidedBy  String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, createdAt])
}

// ────────────── Platform administration ──────────────

// Manual (offline) or recorded payments, entered by the platform superadmin.
model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  amountCents Int
  currency    String   @default("USD")
  method      String   @default("manual") // manual | bank_transfer | cash | stripe | other
  reference   String?
  note        String?
  plan        String?  // plan this payment activated, if any
  months      Int?     // months of access granted, if any
  recordedBy  String   // userId of the superadmin
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
}

// Platform-wide key/value settings (payment methods). Secrets inside are encrypted.
model PlatformSetting {
  key       String   @id
  value     Json?
  updatedAt DateTime @updatedAt
}

// Google / Microsoft sign-in links. verified=false means the provider did not vouch for the email address.
model OAuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  subject   String
  email     String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, subject])
  @@index([userId])
}

// Built-in scheduling: people book time through the public booking page or the AI's link.
model Booking {
  id         String   @id @default(cuid())
  businessId String
  typeId     String
  typeTitle  String
  name       String
  email      String
  phone      String?
  notes      String?  @db.Text
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("confirmed") // confirmed | cancelled
  source     String   @default("link")      // link | ai | manual
  token      String   @unique               // guest's private link for calendar download / cancel
  slotKey    String?  @unique               // set while confirmed; blocks double-booking the same start
  joinUrl    String?  @db.Text
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, startsAt])
}
