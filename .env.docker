# Copy this file to ".env" (see docs/DOCKER.md). Only ANTHROPIC_API_KEY is required to start.
NODE_ENV=production
# (DATABASE_URL and REDIS_URL are set by docker-compose.yml — nothing to do)
APP_URL=http://localhost:4000
API_URL=http://localhost:4000
# generate your own: https://generate-random.org  (any long random text for JWT_SECRET)
JWT_SECRET=REPLACE_WITH_ANY_LONG_RANDOM_TEXT
# must be exactly 64 hex characters (0-9 a-f)
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_FROM_EMAIL=hello@yourdomain.com
