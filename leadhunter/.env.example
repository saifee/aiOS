# ── Core ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-me-64-chars
ENCRYPTION_KEY=change-me-32-bytes-hex

# ── Data stores ──────────────────────────────────────
DATABASE_URL=postgresql://leadhunter:leadhunter@localhost:5432/leadhunter
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=leadhunter
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# ── AI providers ─────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Lead discovery / enrichment ──────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
HUNTER_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=
SERPAPI_API_KEY=

# ── Outreach ─────────────────────────────────────────
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WHATSAPP_CLOUD_TOKEN=            # Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Calendar / meetings ──────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
CALCOM_API_KEY=

# ── Notifications ────────────────────────────────────
SLACK_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
FCM_SERVER_KEY=

# ── Billing ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI Operating System additions ────────────────────
DEFAULT_FROM_EMAIL=hello@yourdomain.com
CLAUDE_MODEL=claude-sonnet-4-5
# Embeddings for the Knowledge Brain (OpenAI text-embedding-3-small, 1536-dim)
# reuses OPENAI_API_KEY above

# ── AI Receptionist (voice) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_PORT=5050
VOICE_WS_URL=wss://your-voice-bridge-domain   # public wss URL of services/voice
DEFAULT_TRANSFER_NUMBER=            # E.164 human fallback for urgent call transfers
# OpenAI Realtime API uses OPENAI_API_KEY above

# ── Billing (Stripe price IDs from your dashboard) ───
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ── Tier 3: Dev Swarm (multi-model) ──────────────────
GEMINI_MODEL=gemini-1.5-pro
OPENAI_MODEL=gpt-4o
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GITHUB_TOKEN=              # repo scope — for the swarm to open PRs

# ── Tier 3: Creative ─────────────────────────────────
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# image generation uses OPENAI_API_KEY (gpt-image-1)

# ── Tier 3: Social publishing (per-network OAuth tokens stored via Integrations) ──
# linkedin: { token, authorUrn }  facebook: { pageId, token }
# instagram: { igUserId, token }  x: { token }
