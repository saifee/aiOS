# ── Core ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-me-64-chars
ENCRYPTION_KEY=change-me-32-bytes-hex

# ── Data stores ──────────────────────────────────────
# MySQL / MariaDB   (Hostinger: mysql://u123_user:PASS@localhost:3306/u123_db)
DATABASE_URL=mysql://leadhunter:leadhunter@localhost:3306/leadhunter
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=leadhunter
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# ── AI providers ─────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Lead discovery / enrichment ──────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
HUNTER_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=
SERPAPI_API_KEY=

# ── Outreach ─────────────────────────────────────────
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WHATSAPP_CLOUD_TOKEN=            # Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Calendar / meetings ──────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
CALCOM_API_KEY=

# ── Notifications ────────────────────────────────────
SLACK_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
FCM_SERVER_KEY=

# ── Billing ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI Operating System additions ────────────────────
DEFAULT_FROM_EMAIL=hello@yourdomain.com
CLAUDE_MODEL=claude-sonnet-4-5
# Embeddings for the Knowledge Brain (OpenAI text-embedding-3-small, 1536-dim)
# reuses OPENAI_API_KEY above

# ── AI Receptionist (voice) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_PORT=5050
VOICE_WS_URL=wss://your-voice-bridge-domain   # public wss URL of services/voice
DEFAULT_TRANSFER_NUMBER=            # E.164 human fallback for urgent call transfers
# OpenAI Realtime API uses OPENAI_API_KEY above

# ── Billing (Stripe price IDs from your dashboard) ───
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ── Tier 3: Dev Swarm (multi-model) ──────────────────
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-4o
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GITHUB_TOKEN=              # repo scope — for the swarm to open PRs

# ── Tier 3: Creative ─────────────────────────────────
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# image generation uses OPENAI_API_KEY (gpt-image-1)

# ── Tier 3: Social publishing (per-network OAuth tokens stored via Integrations) ──
# linkedin: { token, authorUrn }  facebook: { pageId, token }
# instagram: { igUserId, token }  x: { token }

# ── Security hardening (see docs/security/SECURE_DEPLOYMENT.md) ─────
# Set to true when a trusted reverse proxy (Hostinger/LiteSpeed, Cloudflare, nginx) is in front, so per-IP rate limits use the real client IP.
TRUST_PROXY=true
# Extra browser origins allowed to call the API (comma separated). APP_URL is always allowed.
# CORS_ORIGINS=
# Optional: require this token on the first-run setup wizard (generate: openssl rand -hex 24)
# SETUP_TOKEN=
# JWT lifetime (default 24h)
# JWT_EXPIRES_IN=24h
# Webhook authenticity — unsigned webhooks are REJECTED unless the matching secret is set:
# WHATSAPP_APP_SECRET=          # Meta app secret → X-Hub-Signature-256
# TWILIO_AUTH_TOKEN=            # Twilio → X-Twilio-Signature (also needs APP_URL)
# SENDGRID_WEBHOOK_PUBLIC_KEY=  # SendGrid Signed Event Webhook public key (base64)
# WEBHOOK_SHARED_SECRET=        # append ?token=… to SendGrid Inbound Parse / Cal.com webhook URLs
# CALCOM_WEBHOOK_SECRET=
# Self-hosting only: allow custom AI endpoints on private addresses (e.g. Ollama on localhost). Leave unset on shared/SaaS hosting.
# ALLOW_PRIVATE_AI_URLS=true
# Temporarily show database error detail on /setup/status in production
# SETUP_DEBUG=true

# Docker only: database passwords (openssl rand -hex 16). No defaults are shipped.
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Optional shared key between API and the Python AI service (both must match)
# AI_SERVICE_KEY=

# Platform superadmin: comma-separated emails allowed to see all users/subscriptions, allocate plans and record payments.
# If left empty, the very first account created (via /setup) is the superadmin.
# SUPERADMIN_EMAILS=you@example.com

# Address used by "Talk to us" on the plan page (defaults to first SUPERADMIN_EMAILS)
CONTACT_EMAIL=

# ── Sign in with Google / Microsoft (optional; a button appears when both values of a pair are set) ──
# Redirect URI to register at the provider:  <APP_URL>/v1/auth/oauth/google/callback  and  <APP_URL>/v1/auth/oauth/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# common = work + personal accounts (default). Use consumers, organizations, or a tenant ID to restrict.
# MICROSOFT_TENANT=common

# ── Bot protection (CAPTCHA) on sign-in, sign-up, first-run setup and the public booking page ──
# Cloudflare Turnstile (free, no puzzles for most people):  CAPTCHA_PROVIDER=turnstile
#   Create a widget at dash.cloudflare.com → Turnstile; add your domain; paste the Site Key and Secret Key.
# Google reCAPTCHA v2 ("I'm not a robot" checkbox):         CAPTCHA_PROVIDER=recaptcha
#   Register at google.com/recaptcha/admin (type v2 Checkbox); add your domain; paste the Site Key and Secret Key.
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
