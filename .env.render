# ── Kingslee AIOS — Render (full stack). Prefer setting these in the Render
#    dashboard / render.yaml. The blueprint auto-wires DATABASE_URL and REDIS_URL
#    if you use Render's own Postgres+Redis; use the values below only if you
#    point at external services like Supabase. ──

NODE_ENV=production
APP_URL=https://your-app.onrender.com
AI_SERVICE_URL=http://leadhunter-ai:8000     # Render private network hostname:port

# ── Supabase Postgres (replace [YOUR-DB-PASSWORD]) ──
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.twbklhipuzppkrbvheca.supabase.co:5432/postgres

# ── Redis (from your Render Key Value instance's internal URL) ──
REDIS_URL=REPLACE_WITH_RENDER_KEYVALUE_INTERNAL_URL

# ── Secrets — generate each with: openssl rand -hex 32 ──
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARS

# ── AI (required) ──
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=                    # image generation + embeddings + swarm fixer
GEMINI_API_KEY=                    # optional — swarm reviewer
PERPLEXITY_API_KEY=                # optional — swarm researcher

DEFAULT_FROM_EMAIL=hello@kingslee.net
